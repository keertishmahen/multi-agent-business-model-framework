# ── Local development (optional — users can enter key in UI instead) ──
# REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# RAG backend URL (frontend). Leave unset for localhost:3002 in dev.
# REACT_APP_RAG_URL=http://localhost:3002

# Production builds use .env.production (bms-api). Do not bake localhost into Azure deploys.

# ── Server only (Azure App Service Application Settings — never in frontend) ──
# GEMINI_API_KEY=
# CORS_ORIGIN=https://bms-web.z1.web.core.windows.net
# PORT=8080
